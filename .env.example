# Copy to .env and fill in. NEVER commit .env.

# --- LLM (primary: Groq) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- LLM fallbacks (optional) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Search (optional; DuckDuckGo fallback works without keys) ---
TAVILY_API_KEY=
SERPER_API_KEY=

# --- GitHub (optional; raises rate limit) ---
GITHUB_TOKEN=

# --- Paths / timeouts (defaults are fine) ---
# DATA_DIR=data
# FETCH_TIMEOUT=20
# CANDIDATE_TIMEOUT=45
